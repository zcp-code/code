<view class="container data-v-b9388344"><view class="header data-v-b9388344"><text class="logo-icon data-v-b9388344">🍎</text><text class="title data-v-b9388344">{{roleLabel+"账号密码登录"}}</text></view><view class="card data-v-b9388344"><view class="form-row data-v-b9388344"><text class="label data-v-b9388344">账号</text><input class="input data-v-b9388344" placeholder="{{role==='wholesaler'?'批发商账号':'采购商账号'}}" data-event-opts="{{[['input',[['__set_model',['','account','$event',[]]],['onAccountInput',['$event']]]]]}}" value="{{account}}" bindinput="__e"/></view><view class="form-row data-v-b9388344"><text class="label data-v-b9388344">密码</text><input class="input data-v-b9388344" password="{{true}}" placeholder="8-20 位" data-event-opts="{{[['input',[['__set_model',['','password','$event',[]]],['onPasswordInput',['$event']]]]]}}" value="{{password}}" bindinput="__e"/></view></view><view class="demo-tip data-v-b9388344">演示账号:buyer001 / wh001 / test1234</view><button class="btn-primary data-v-b9388344" disabled="{{submitting}}" data-event-opts="{{[['tap',[['onLogin',['$event']]]]]}}" bindtap="__e">{{''+(submitting?'登录中...':'登录')+''}}</button><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="back-tip data-v-b9388344" bindtap="__e">‹ 返回</view></view>