<view class="container data-v-6b5ffe82"><view class="search-header data-v-6b5ffe82"><view class="search-box data-v-6b5ffe82"><text class="search-icon iconfont icon-sousuo data-v-6b5ffe82"></text><input class="search-input data-v-6b5ffe82" placeholder="搜索店铺名称" data-event-opts="{{[['confirm',[['load',[true]]]],['input',[['__set_model',['','keyword','$event',[]]]]]]}}" value="{{keyword}}" bindconfirm="__e" bindinput="__e"/><block wx:if="{{keyword}}"><text data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="clear-icon data-v-6b5ffe82" bindtap="__e">×</text></block></view></view><view class="stats-row data-v-6b5ffe82"><view class="stat-item data-v-6b5ffe82"><text class="stat-num data-v-6b5ffe82">{{$root.g0}}</text><text class="stat-label data-v-6b5ffe82">家店铺</text></view><view class="stat-item data-v-6b5ffe82"><text class="stat-num data-v-6b5ffe82">{{totalToday}}</text><text class="stat-label data-v-6b5ffe82">今日上新</text></view><view class="stat-item data-v-6b5ffe82"><text class="stat-num data-v-6b5ffe82">{{favCount}}</text><text class="stat-label data-v-6b5ffe82">已收藏</text></view></view><view class="shop-list data-v-6b5ffe82"><block wx:if="{{$root.g1}}"><view class="state-card data-v-6b5ffe82"><text class="state-icon data-v-6b5ffe82">⏳</text><text class="state-text data-v-6b5ffe82">加载中...</text></view></block><block wx:else><block wx:if="{{$root.g2===0}}"><view class="state-card data-v-6b5ffe82"><text class="state-icon data-v-6b5ffe82">🏬</text><text class="state-text data-v-6b5ffe82">暂无店铺</text><text class="state-tip data-v-6b5ffe82">试试搜索其他关键词</text></view></block></block><block wx:for="{{list}}" wx:for-item="s" wx:for-index="__i0__" wx:key="id"><view class="shop-card data-v-6b5ffe82"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['list','id',s.id,'id']]]]]]]}}" class="card-row data-v-6b5ffe82" bindtap="__e"><image class="shop-logo data-v-6b5ffe82" src="{{s.logo||'/static/placeholder.png'}}" mode="aspectFill"></image><view class="shop-info data-v-6b5ffe82"><view class="shop-title-line data-v-6b5ffe82"><text class="shop-name ellipsis data-v-6b5ffe82">{{s.name}}</text><block wx:if="{{s.today_count}}"><text class="shop-badge today-new data-v-6b5ffe82">今日上新</text></block><block wx:if="{{s.favorited}}"><text class="shop-badge fav data-v-6b5ffe82">★ 已收藏</text></block><block wx:else><block wx:if="{{!s.today_count}}"><text class="shop-badge data-v-6b5ffe82">未收藏</text></block></block></view><view class="shop-address data-v-6b5ffe82"><text class="iconfont icon-dizhi data-v-6b5ffe82"></text><text class="addr-text ellipsis data-v-6b5ffe82">{{s.position||'暂无地址'}}</text></view><view class="shop-meta data-v-6b5ffe82"><block wx:if="{{s.today_count}}"><text class="meta-tag new data-v-6b5ffe82">{{'📦 今日到货 '+s.today_count+' 种'}}</text></block><block wx:if="{{s.business_hours}}"><text class="meta-tag time data-v-6b5ffe82">{{'🕐 '+s.business_hours+''}}</text></block></view></view></view><view class="card-actions data-v-6b5ffe82"><view data-event-opts="{{[['tap',[['callPhone',['$0'],[[['list','id',s.id]]]]]]]}}" class="action-btn call data-v-6b5ffe82" catchtap="__e"><text class="iconfont icon-dianhua data-v-6b5ffe82"></text><text class="data-v-6b5ffe82">电话</text></view><view data-event-opts="{{[['tap',[['toggleFav',['$0','$event'],[[['list','id',s.id]]]]]]]}}" class="{{['action-btn','data-v-6b5ffe82',(s.favorited)?'fav':'']}}" catchtap="__e"><text class="data-v-6b5ffe82">{{s.favorited?'★ 已收藏':'☆ 收藏'}}</text></view><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['list','id',s.id,'id']]]]]]]}}" class="action-btn primary data-v-6b5ffe82" catchtap="__e"><text class="data-v-6b5ffe82">进店 →</text></view></view></view></block><block wx:if="{{$root.g3}}"><view class="more-tip data-v-6b5ffe82">— 没有更多了 —</view></block></view><custom-tabbar vue-id="00a052c4-1" class="data-v-6b5ffe82" bind:__l="__l"></custom-tabbar></view>