
page.data-v-6b5ffe82 { background-color: #f5f5f5;
}
.container.data-v-6b5ffe82 { min-height: 100vh; padding-bottom: 120rpx; background-color: #f5f5f5;
}
/* === 搜索栏 === */
.search-header.data-v-6b5ffe82 {
  background: linear-gradient(135deg, #ff6600, #ff8a5b);
  padding: 32rpx 28rpx 56rpx;
}
.search-box.data-v-6b5ffe82 {
  display: flex; align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.08);
}
.search-icon.data-v-6b5ffe82 {
  font-size: 32rpx;
  color: #ff6600;
  margin-right: 12rpx;
}
.search-input.data-v-6b5ffe82 {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
}
.clear-icon.data-v-6b5ffe82 {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ccc;
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}
/* === 数据概览条(向上覆盖搜索栏底) === */
.stats-row.data-v-6b5ffe82 {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
  margin: -30rpx 0 0;
}
.stat-item.data-v-6b5ffe82 {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06);
}
.stat-num.data-v-6b5ffe82 {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff6600;
  display: block;
}
.stat-label.data-v-6b5ffe82 {
  color: #999;
  font-size: 22rpx;
  margin-top: 4rpx;
}
/* === 状态卡片(加载/空) === */
.state-card.data-v-6b5ffe82 {
  background: #fff;
  border-radius: 12rpx;
  padding: 80rpx 0;
  text-align: center;
  margin-bottom: 20rpx;
}
.state-icon.data-v-6b5ffe82 { font-size: 80rpx; display: block; margin-bottom: 12rpx;
}
.state-text.data-v-6b5ffe82 { color: #999; font-size: 28rpx; display: block;
}
.state-tip.data-v-6b5ffe82 { color: #ccc; font-size: 24rpx; margin-top: 8rpx; display: block;
}
/* === 店铺列表 === */
.shop-list.data-v-6b5ffe82 {
  padding: 20rpx 24rpx 0;
}
/* 店铺卡片 */
.shop-card.data-v-6b5ffe82 {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
  overflow: hidden;
}
.card-row.data-v-6b5ffe82 {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
}
.shop-logo.data-v-6b5ffe82 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.shop-info.data-v-6b5ffe82 {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.shop-title-line.data-v-6b5ffe82 {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.shop-name.data-v-6b5ffe82 {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  max-width: 50%;
}
.shop-badge.data-v-6b5ffe82 {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.shop-badge.fav.data-v-6b5ffe82 { color: #ff6600; background: #fff2e8;
}
.shop-badge.today-new.data-v-6b5ffe82 { color: #fff; background: #ff6600;
}
.shop-badge.data-v-6b5ffe82:not(.fav):not(.today-new) {
  color: #999;
  background: #f5f5f5;
}
.shop-address.data-v-6b5ffe82 {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
  gap: 8rpx;
}
.addr-text.data-v-6b5ffe82 { flex: 1;
}
.shop-meta.data-v-6b5ffe82 {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.meta-tag.data-v-6b5ffe82 {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  color: #555;
  background: #f5f5f5;
}
.meta-tag.new.data-v-6b5ffe82 {
  color: #27ae60;
  background: #e8f5e9;
  font-weight: 500;
}
.meta-tag.time.data-v-6b5ffe82 {
  color: #666;
}
/* === 底部操作条 === */
.card-actions.data-v-6b5ffe82 {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
  background: #fafafa;
}
.action-btn.data-v-6b5ffe82 {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: background .15s;
}
.action-btn.data-v-6b5ffe82:not(:last-child) { border-right: 1rpx solid #f5f5f5;
}
.action-btn.data-v-6b5ffe82:active { background: #f0f0f0;
}
.action-btn.call.data-v-6b5ffe82 { color: #ff6600;
}
.action-btn.fav.data-v-6b5ffe82 { color: #ff6600; background: #fff2e8;
}
.action-btn.primary.data-v-6b5ffe82 {
  color: #fff;
  background: #ff6600;
  font-weight: 500;
}
.action-btn.primary.data-v-6b5ffe82:active { background: #e55a00;
}
.more-tip.data-v-6b5ffe82 {
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
  padding: 24rpx 0;
}

