<block wx:if="{{shop}}"><view class="container data-v-71bf3ec6"><view class="header data-v-71bf3ec6"><view class="header-row data-v-71bf3ec6"><image class="shop-logo data-v-71bf3ec6" src="{{shop.logo||'/static/placeholder.png'}}" mode="aspectFill"></image><view class="shop-info data-v-71bf3ec6"><view class="shop-name data-v-71bf3ec6">{{shop.name}}</view><view class="shop-meta data-v-71bf3ec6"><text class="iconfont icon-dizhi data-v-71bf3ec6"></text><text class="meta-text data-v-71bf3ec6">{{shop.position||'暂无地址'}}</text></view><block wx:if="{{shop.business_hours}}"><view class="shop-meta data-v-71bf3ec6"><text class="iconfont icon-shijian data-v-71bf3ec6"></text><text class="meta-text data-v-71bf3ec6">{{shop.business_hours}}</text></view></block></view></view><block wx:if="{{shop.intro}}"><view class="shop-intro data-v-71bf3ec6">{{shop.intro}}</view></block></view><view class="action-bar data-v-71bf3ec6"><view data-event-opts="{{[['tap',[['toggleFav',['$event']]]]]}}" class="{{['action-btn','fav','data-v-71bf3ec6',(favorited)?'active':'']}}" bindtap="__e"><text class="action-icon data-v-71bf3ec6">{{favorited?'★':'☆'}}</text><text class="action-label data-v-71bf3ec6">{{favorited?'已收藏':'收藏'}}</text></view><view data-event-opts="{{[['tap',[['callShop',['$event']]]]]}}" class="action-btn call data-v-71bf3ec6" bindtap="__e"><text class="action-icon iconfont icon-dianhua data-v-71bf3ec6"></text><text class="action-label data-v-71bf3ec6">拨打电话</text></view></view><view class="goods-list data-v-71bf3ec6"><block wx:if="{{$root.g0}}"><view class="state-empty data-v-71bf3ec6">⏳ 加载中...</view></block><block wx:else><block wx:if="{{$root.g1===0}}"><view class="state-empty data-v-71bf3ec6"><view class="state-icon data-v-71bf3ec6">📦</view><view class="data-v-71bf3ec6">该店铺暂无货盘</view></view></block></block><block wx:for="{{$root.l0}}" wx:for-item="g" wx:for-index="__i0__" wx:key="id"><view class="goods-card data-v-71bf3ec6"><image class="goods-cover data-v-71bf3ec6" src="{{g.$orig.cover||'/static/placeholder.png'}}" mode="aspectFill" data-event-opts="{{[['tap',[['goDetail',['$0'],[[['goodsList','id',g.$orig.id,'id']]]]]]]}}" bindtap="__e"></image><view class="goods-info data-v-71bf3ec6"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['goodsList','id',g.$orig.id,'id']]]]]]]}}" class="goods-name ellipsis-2 data-v-71bf3ec6" bindtap="__e">{{g.$orig.name}}</view><view class="goods-price data-v-71bf3ec6">{{"¥"+g.g2}}<text class="price-unit data-v-71bf3ec6">{{"/"+g.$orig.unit}}</text></view><view class="goods-stock data-v-71bf3ec6">{{"库存 "+g.$orig.total_stock+" · 可订 "+g.$orig.available}}</view></view><view data-event-opts="{{[['tap',[['quickReserve',['$0'],[[['goodsList','id',g.$orig.id]]]]]]]}}" class="goods-action data-v-71bf3ec6" bindtap="__e">一键预定</view></view></block></view><block wx:if="{{showSheet}}"><view data-event-opts="{{[['tap',[['closeSheet',['$event']]]]]}}" class="sheet-mask data-v-71bf3ec6" bindtap="__e"></view></block><block wx:if="{{bookGoods}}"><view class="{{['sheet','data-v-71bf3ec6',(showSheet)?'sheet-show':'']}}"><view class="sheet-handle data-v-71bf3ec6"></view><view class="sheet-header data-v-71bf3ec6"><view class="sheet-title data-v-71bf3ec6"><view class="title-main data-v-71bf3ec6">预订货品</view><view class="title-sub data-v-71bf3ec6">{{bookGoods.name}}</view></view><view data-event-opts="{{[['tap',[['closeSheet',['$event']]]]]}}" class="sheet-close data-v-71bf3ec6" bindtap="__e">×</view></view><view class="sheet-body data-v-71bf3ec6"><view class="sheet-price data-v-71bf3ec6"><text class="price-label data-v-71bf3ec6">单价</text><text class="price-value data-v-71bf3ec6">{{"¥"+$root.g3}}</text><text class="price-unit data-v-71bf3ec6">{{"/"+bookGoods.unit}}</text></view><view class="sheet-stock data-v-71bf3ec6"><text class="stock-label data-v-71bf3ec6">可订库存</text><text class="stock-value data-v-71bf3ec6">{{$root.g4+" "+bookGoods.unit}}</text></view><view class="qty-section data-v-71bf3ec6"><text class="qty-label data-v-71bf3ec6">预订数量</text><view class="qty-control data-v-71bf3ec6"><view data-event-opts="{{[['tap',[['decQty',['$event']]]]]}}" class="qty-btn data-v-71bf3ec6" bindtap="__e">-</view><input class="qty-input data-v-71bf3ec6" type="number" min="{{1}}" max="{{bookGoods.available}}" data-event-opts="{{[['input',[['__set_model',['','bookQty','$event',['number']]]]],['blur',[['$forceUpdate']]]]}}" value="{{bookQty}}" bindinput="__e" bindblur="__e"/><text class="qty-unit data-v-71bf3ec6">{{bookGoods.unit}}</text><view data-event-opts="{{[['tap',[['incQty',['$event']]]]]}}" class="qty-btn data-v-71bf3ec6" bindtap="__e">+</view></view><view class="qty-total data-v-71bf3ec6"><text class="data-v-71bf3ec6">预计金额</text><text class="total-amount data-v-71bf3ec6">{{"¥"+$root.g5}}</text></view></view></view><button class="sheet-submit data-v-71bf3ec6" disabled="{{submitting}}" data-event-opts="{{[['tap',[['submitBook',['$event']]]]]}}" bindtap="__e">{{''+(submitting?'提交中...':'提交预订')+''}}</button><view class="sheet-tip data-v-71bf3ec6"> 📌 提交后由批发商确认,确认前可取消 </view></view></block></view></block>