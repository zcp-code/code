<block wx:if="{{shop}}"><view class="container data-v-71bf3ec6"><view class="header data-v-71bf3ec6"><view class="header-row data-v-71bf3ec6"><view class="shop-logo data-v-71bf3ec6">{{shop.emoji||'🏬'}}</view><view class="shop-info data-v-71bf3ec6"><view class="shop-name data-v-71bf3ec6">{{shop.name}}</view><view class="shop-loc data-v-71bf3ec6">{{"📍 "+(shop.position||'暂无地址')}}</view></view></view></view><view class="action-row data-v-71bf3ec6"><view data-event-opts="{{[['tap',[['toggleFav',['$event']]]]]}}" class="btn-plain data-v-71bf3ec6" bindtap="__e">{{''+(favorited?'★ 已收藏':'☆ 收藏店铺')+''}}</view><view data-event-opts="{{[['tap',[['callShop',['$event']]]]]}}" class="btn-green data-v-71bf3ec6" bindtap="__e">📞 拨打电话</view></view><view class="card data-v-71bf3ec6"><view class="section-title data-v-71bf3ec6">{{"店铺货盘 "+$root.g0+" 个"}}</view><block wx:if="{{loading}}"><view class="loading data-v-71bf3ec6">加载中...</view></block><block wx:else><block wx:if="{{$root.g1===0}}"><view class="empty data-v-71bf3ec6">📦 该店铺暂无货盘</view></block></block><block wx:for="{{$root.l0}}" wx:for-item="g" wx:for-index="__i0__" wx:key="id"><view class="goods-card data-v-71bf3ec6"><view class="emoji-cover data-v-71bf3ec6">{{g.m0}}</view><view class="info data-v-71bf3ec6"><view class="name ellipsis-2 data-v-71bf3ec6">{{g.$orig.name}}</view><view class="meta data-v-71bf3ec6">{{g.$orig.publish_time_label||'今日上新'}}</view><view class="stock data-v-71bf3ec6">{{"库存 "+g.g2+" "+g.$orig.unit}}</view><view class="price data-v-71bf3ec6">{{"¥"+g.g3+"/"+g.$orig.unit}}</view><view class="card-actions data-v-71bf3ec6"><view data-event-opts="{{[['tap',[['quickReserve',['$0'],[[['goodsList','id',g.$orig.id]]]]]]]}}" class="btn-primary data-v-71bf3ec6" bindtap="__e">一键预定</view></view></view></view></block></view><block wx:if="{{showSheet}}"><view data-event-opts="{{[['tap',[['closeSheet',['$event']]]]]}}" class="sheet-mask data-v-71bf3ec6" bindtap="__e"></view></block><block wx:if="{{bookGoods}}"><view class="{{['sheet','data-v-71bf3ec6',(showSheet)?'sheet-show':'']}}"><view class="sheet-header data-v-71bf3ec6"><text class="sheet-title data-v-71bf3ec6">{{"一键预定 · "+bookGoods.name}}</text><text data-event-opts="{{[['tap',[['closeSheet',['$event']]]]]}}" class="sheet-close data-v-71bf3ec6" bindtap="__e">×</text></view><view class="sheet-body data-v-71bf3ec6"><view class="sheet-row data-v-71bf3ec6"><text class="sheet-label data-v-71bf3ec6">单价</text><text class="sheet-value price data-v-71bf3ec6">{{"¥"+$root.g4+"/"+bookGoods.unit}}</text></view><view class="sheet-row data-v-71bf3ec6"><text class="sheet-label data-v-71bf3ec6">可订库存</text><text class="sheet-value data-v-71bf3ec6">{{$root.g5+" "+bookGoods.unit}}</text></view><view class="sheet-row data-v-71bf3ec6"><text class="sheet-label data-v-71bf3ec6">预订数量</text><view class="qty-input-wrap data-v-71bf3ec6"><input class="qty-input data-v-71bf3ec6" type="number" data-event-opts="{{[['input',[['__set_model',['','bookQty','$event',[]]]]]]}}" value="{{bookQty}}" bindinput="__e"/><text class="qty-unit data-v-71bf3ec6">{{bookGoods.unit}}</text></view></view><button class="sheet-submit data-v-71bf3ec6" disabled="{{submitting}}" data-event-opts="{{[['tap',[['submitBook',['$event']]]]]}}" bindtap="__e">{{''+(submitting?'提交中...':'提交预订')+''}}</button><view class="sheet-tip data-v-71bf3ec6">提交后由批发商确认，确认前可取消</view></view></view></block></view></block>