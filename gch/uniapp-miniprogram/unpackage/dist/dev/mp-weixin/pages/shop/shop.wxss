/* Sheet 弹层 */
.sheet-mask.data-v-71bf3ec6 {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.5);
  z-index: 999;
}
.sheet.data-v-71bf3ec6 {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
  z-index: 1000;
  padding: 20rpx 18rpx 30rpx;
  -webkit-transform: translateY(100%);
          transform: translateY(100%);
  transition: -webkit-transform .25s ease-out;
  transition: transform .25s ease-out;
  transition: transform .25s ease-out, -webkit-transform .25s ease-out;
}
.sheet-show.data-v-71bf3ec6 { -webkit-transform: translateY(0); transform: translateY(0);
}
.sheet-header.data-v-71bf3ec6 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.sheet-title.data-v-71bf3ec6 { font-size: 32rpx; font-weight: 700; color: #111; flex: 1;
}
.sheet-close.data-v-71bf3ec6 {
  font-size: 40rpx;
  color: #999;
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
}
.sheet-body.data-v-71bf3ec6 { padding-top: 20rpx;
}
.sheet-row.data-v-71bf3ec6 {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  justify-content: space-between;
}
.sheet-label.data-v-71bf3ec6 { color: #666; font-size: 28rpx;
}
.sheet-value.data-v-71bf3ec6 { color: #111; font-size: 28rpx;
}
.sheet-value.price.data-v-71bf3ec6 { color: #ff6600; font-weight: 600;
}
.qty-input-wrap.data-v-71bf3ec6 {
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 64rpx;
}
.qty-input.data-v-71bf3ec6 {
  flex: 1;
  height: 60rpx;
  font-size: 32rpx;
  text-align: right;
}
.qty-unit.data-v-71bf3ec6 { color: #999; font-size: 26rpx; margin-left: 12rpx;
}
.sheet-submit.data-v-71bf3ec6 {
  width: 100%;
  background: #ff6600;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
