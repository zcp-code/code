<block wx:if="{{goods}}"><view class="container data-v-5566b618"><swiper class="banner data-v-5566b618" indicator-dots="{{true}}" autoplay="{{true}}" circular="{{true}}"><block wx:for="{{images}}" wx:for-item="img" wx:for-index="__i0__" wx:key="id"><swiper-item class="data-v-5566b618"><image class="banner-img data-v-5566b618" src="{{img.url}}" mode="aspectFill"></image></swiper-item></block><block wx:if="{{$root.g0===0}}"><swiper-item class="data-v-5566b618"><view class="banner-empty data-v-5566b618">暂无图片</view></swiper-item></block></swiper><view class="card data-v-5566b618"><view class="price-row data-v-5566b618"><text class="price data-v-5566b618">{{"¥"+$root.g1}}</text><text class="unit data-v-5566b618">{{"/"+goods.unit}}</text><text class="available data-v-5566b618">{{"可订 "+goods.available}}</text></view><view class="name data-v-5566b618">{{goods.name}}</view><view class="meta data-v-5566b618">{{"店铺:"+(goods.shop?goods.shop.name:'-')}}</view></view><view class="card data-v-5566b618"><view class="section-title data-v-5566b618">货品描述</view><view class="desc data-v-5566b618">{{goods.description||'暂无描述'}}</view></view><view class="action-bar data-v-5566b618"><view data-event-opts="{{[['tap',[['callWholesaler',['$event']]]]]}}" class="action-btn call data-v-5566b618" bindtap="__e">📞 联系批发商</view><view data-event-opts="{{[['tap',[['toggleFav',['$event']]]]]}}" class="{{['action-btn','fav','data-v-5566b618',favorited?'active':'']}}" bindtap="__e">{{''+(favorited?'★ 已收藏':'☆ 收藏')+''}}</view><view data-event-opts="{{[['tap',[['openBookSheet',['$event']]]]]}}" class="action-btn primary data-v-5566b618" bindtap="__e">一键预订</view></view><block wx:if="{{showSheet}}"><view data-event-opts="{{[['tap',[['closeBookSheet',['$event']]]]]}}" class="sheet-mask data-v-5566b618" bindtap="__e"></view></block><block wx:if="{{goods}}"><view class="{{['sheet','data-v-5566b618',(showSheet)?'sheet-show':'']}}"><view class="sheet-header data-v-5566b618"><text class="sheet-title data-v-5566b618">{{"一键预定 · "+goods.name}}</text><text data-event-opts="{{[['tap',[['closeBookSheet',['$event']]]]]}}" class="sheet-close data-v-5566b618" bindtap="__e">×</text></view><view class="sheet-body data-v-5566b618"><view class="sheet-row data-v-5566b618"><text class="sheet-label data-v-5566b618">单价</text><text class="sheet-value price data-v-5566b618">{{"¥"+$root.g2+"/"+goods.unit}}</text></view><view class="sheet-row data-v-5566b618"><text class="sheet-label data-v-5566b618">可订库存</text><text class="sheet-value data-v-5566b618">{{$root.g3+" "+goods.unit}}</text></view><view class="sheet-row data-v-5566b618"><text class="sheet-label data-v-5566b618">预订数量</text><view class="qty-input-wrap data-v-5566b618"><input class="qty-input data-v-5566b618" type="number" data-event-opts="{{[['input',[['__set_model',['','bookQty','$event',[]]]]]]}}" value="{{bookQty}}" bindinput="__e"/><text class="qty-unit data-v-5566b618">{{goods.unit}}</text></view></view><button class="sheet-submit data-v-5566b618" disabled="{{submitting}}" data-event-opts="{{[['tap',[['submitBook',['$event']]]]]}}" bindtap="__e">{{''+(submitting?'提交中...':'提交预订')+''}}</button><view class="sheet-tip data-v-5566b618">提交后由批发商确认，确认前可取消</view></view></view></block></view></block>