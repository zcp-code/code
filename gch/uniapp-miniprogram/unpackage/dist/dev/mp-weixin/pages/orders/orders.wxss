  text-align: center;
}
.tab-item.active .tab-badge.data-v-8a71bbb4 { background: #fff1e6; color: #ff6600;
}
.tab-underline.data-v-8a71bbb4 {
  position: absolute;
  bottom: 0;
  left: 50%;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #ff6600, #ff8c42);
  border-radius: 3rpx;
}

