}
.tabs-inner.data-v-8a71bbb4 {
  display: inline-flex;
  align-items: center;
  padding: 0 20rpx;
}
.tab-item.data-v-8a71bbb4 {
  position: relative;
  display: inline-flex;
  align-items: center;
  padding: 26rpx 28rpx 24rpx;
  margin-right: 8rpx;
}
.tab-text.data-v-8a71bbb4 {
  font-size: 30rpx;
