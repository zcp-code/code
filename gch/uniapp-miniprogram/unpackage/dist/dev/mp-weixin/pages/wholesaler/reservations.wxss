
page.data-v-2f298339 { background-color: #f5f5f5;
}
.container.data-v-2f298339 { padding-bottom: 120rpx;
}
/* === Tabs === */
.tabs.data-v-2f298339 {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin: 16rpx 24rpx 0;
  overflow: hidden;
}
.tab.data-v-2f298339 {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  color: #666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.tab.active.data-v-2f298339 {
  color: #ff6600;
  border-bottom: 4rpx solid #ff6600;
}
.tab-badge.data-v-2f298339 {
  background: #f0f0f0;
  color: #666;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
}
.tab-badge.orange.data-v-2f298339 { background: #fff2e8; color: #ff6600;
}
.tab-badge.green.data-v-2f298339  { background: #e8f5e9; color: #27ae60;
}
.tab-badge.gray.data-v-2f298339   { background: #f5f5f5; color: #999;
}
/* === 列表 === */
.res-list.data-v-2f298339 {
  padding: 16rpx 24rpx;
}
.empty-tip.data-v-2f298339 {
  background: #fff;
  border-radius: 12rpx;
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}
.more-tip.data-v-2f298339 {
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
  padding: 20rpx 0;
}
/* === 预订卡片 === */
.res-card.data-v-2f298339 {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.res-head.data-v-2f298339 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.res-no.data-v-2f298339 {
  color: #999;
  font-size: 22rpx;
  font-family: monospace;
}
.res-status.data-v-2f298339 {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
  font-weight: 500;
}
.status-pending.data-v-2f298339   { color: #ff6600; background: #fff2e8;
}
.status-confirmed.data-v-2f298339 { color: #27ae60; background: #e8f5e9;
}
.status-cancelled.data-v-2f298339 { color: #999;     background: #f5f5f5;
}
.res-time.data-v-2f298339 {
  color: #999;
  font-size: 22rpx;
  margin-top: 6rpx;
}
/* 货品行 */
.goods-row.data-v-2f298339 {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  align-items: center;
}
.goods-cover.data-v-2f298339 {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.goods-info.data-v-2f298339 { flex: 1; min-width: 0;
}
.goods-name.data-v-2f298339 {
  font-size: 28rpx;
  font-weight: 500;
  color: #111;
  line-height: 1.4;
}
.goods-spec.data-v-2f298339 {
  color: #999;
  font-size: 22rpx;
  margin-top: 6rpx;
}
.goods-total.data-v-2f298339 {
  color: #ff6600;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 6rpx;
}
/* 采购商 + 店铺 (合并单行) */
.party-row.data-v-2f298339 {
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-top: 4rpx;
}
.party-item.data-v-2f298339 {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top:10rpx;
}
.party-icon.data-v-2f298339 {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
  flex-shrink: 0;
  margin-right: 6rpx;
}
.party-icon-buyer.data-v-2f298339 { background: linear-gradient(135deg, #ff9966, #ff6600);
}
.party-icon-shop.data-v-2f298339  { background: linear-gradient(135deg, #4facfe, #00b3a4);
}
.party-name.data-v-2f298339 {
  font-size: 24rpx;
  color: #555;
  flex: 1;
  min-width: 0;
}
/* 操作按钮 */
.res-actions.data-v-2f298339 {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
}
.btn.data-v-2f298339{
	width: 25%;
	flex: 0 0 25%;
}
.btn-gray.data-v-2f298339 {

  background: #f5f5f5;
  color: #666;
  border-radius: 32rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  text-align: center;
}
.btn-gray.data-v-2f298339:active { background: #e5e5e5;
}
.btn-warn.data-v-2f298339 {
  
  background: #fff;
  color: #e55a00;
  border: 1rpx solid #ff6600;
  border-radius: 32rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  text-align: center;
}
.btn-outline.data-v-2f298339 {
 
  background: #fff;
  color: #ff6600;
  border: 1rpx solid #ff6600;
  border-radius: 32rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  text-align: center;
}
.btn-primary.data-v-2f298339 {

  background: #ff6600;
  color: #fff;
  border-radius: 32rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  text-align: center;
  font-weight: 500;
}
.btn-primary.data-v-2f298339:active { background: #e55a00;
}

