<view class="container data-v-3a745426"><view class="form-card data-v-3a745426"><view class="form-row data-v-3a745426"><text class="label data-v-3a745426">分类</text><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" data-event-opts="{{[['change',[['onCategoryChange',['$event']]]]]}}" bindchange="__e" class="data-v-3a745426"><view class="picker data-v-3a745426">{{categories[categoryIndex]?categories[categoryIndex].name:'请选择'}}</view></picker></view><view class="form-row data-v-3a745426"><text class="label data-v-3a745426">品名</text><input class="input data-v-3a745426" placeholder="如：烟台红富士苹果" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['form']]]]]}}" value="{{form.name}}" bindinput="__e"/></view><view class="form-row data-v-3a745426"><text class="label data-v-3a745426">单价(元)</text><input class="input data-v-3a745426" type="digit" placeholder="0.00" data-event-opts="{{[['input',[['__set_model',['$0','price','$event',[]],['form']]]]]}}" value="{{form.price}}" bindinput="__e"/></view><view class="form-row data-v-3a745426"><text class="label data-v-3a745426">单位</text><picker range="{{units}}" value="{{unitIndex}}" data-event-opts="{{[['change',[['onUnitChange',['$event']]]]]}}" bindchange="__e" class="data-v-3a745426"><view class="picker data-v-3a745426">{{unitIndex>=0?units[unitIndex]:'请选择'}}</view></picker></view><view class="form-row data-v-3a745426"><text class="label data-v-3a745426">库存</text><input class="input data-v-3a745426" type="number" placeholder="≥1" data-event-opts="{{[['input',[['__set_model',['$0','total_stock','$event',[]],['form']]]]]}}" value="{{form.total_stock}}" bindinput="__e"/></view><view class="form-row column data-v-3a745426"><text class="label data-v-3a745426">图片(选填)</text><view class="image-list data-v-3a745426"><block wx:for="{{images}}" wx:for-item="img" wx:for-index="idx" wx:key="idx"><view class="image-item data-v-3a745426"><image class="image data-v-3a745426" src="{{img}}" mode="aspectFill"></image><view data-event-opts="{{[['tap',[['removeImage',[idx]]]]]}}" class="del data-v-3a745426" bindtap="__e">×</view></view></block><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="image-item add data-v-3a745426" bindtap="__e">+</view></view></view></view><button class="btn-primary submit data-v-3a745426" disabled="{{submitting}}" data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" bindtap="__e">{{''+(submitting?'提交中...':'发布货盘')+''}}</button></view>