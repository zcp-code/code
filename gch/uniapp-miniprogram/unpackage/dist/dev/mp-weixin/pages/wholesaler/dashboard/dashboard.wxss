}
.kv .k.data-v-c3038892 { color: #666; width: 140rpx; flex-shrink: 0; font-size: 24rpx;
}
.kv .v.data-v-c3038892 { color: #111; flex: 1;
}
.booking-actions.data-v-c3038892 {
  display: flex;
