}
.icon-orange.data-v-4f891565 { background: #fff2e8;
}
.icon-green.data-v-4f891565  { background: #e8f5e9;
}
.icon-purple.data-v-4f891565 { background: #f3e5f5;
}
.icon-gray.data-v-4f891565   { background: #f5f5f5;
