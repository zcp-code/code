
page.data-v-4f891565 { background-color: #f5f5f5;
}
.container.data-v-4f891565 { padding-bottom: 120rpx;
}
/* === 用户卡片 === */
.user-card.data-v-4f891565 {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff6600, #ff8a5b);
  border-radius: 16rpx;
  padding: 36rpx 30rpx;
  margin: 20rpx 24rpx 0;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255,107,53,.25);
}
.avatar.data-v-4f891565 {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,.25);
  flex-shrink: 0;
}
.user-info.data-v-4f891565 { flex: 1; margin-left: 20rpx; min-width: 0;
}
.nick.data-v-4f891565 { font-size: 36rpx; font-weight: 700;
}
.role.data-v-4f891565 { font-size: 24rpx; opacity: .9; margin-top: 6rpx;
}
.edit-btn.data-v-4f891565 {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
/* === 数据概览 === */
.stats-row.data-v-4f891565 {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
  margin-top: -30rpx;
}
.stat-cell.data-v-4f891565 {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06);
}
.stat-num.data-v-4f891565 {
  font-size: 38rpx;
  font-weight: 700;
  color: #ff6600;
  display: block;
}
.stat-label.data-v-4f891565 {
  color: #999;
  font-size: 22rpx;
  margin-top: 4rpx;
}
/* === 卡片 === */
.card.data-v-4f891565 {
  background: #fff;
  border-radius: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.section-title.data-v-4f891565 {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f2f2f2;
