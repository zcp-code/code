<block wx:if="{{goods}}"><view class="container data-v-6464a680"><view class="card goods-summary data-v-6464a680"><image class="cover data-v-6464a680" src="{{goods.cover||'/static/placeholder.png'}}" mode="aspectFill"></image><view class="info data-v-6464a680"><view class="name ellipsis-2 data-v-6464a680">{{goods.name}}</view><view class="price data-v-6464a680">{{"¥"+goods.price+"/"+goods.unit}}</view><view class="available data-v-6464a680">{{"可订 "+goods.available+" "+goods.unit}}</view></view></view><view class="card data-v-6464a680"><view class="form-row data-v-6464a680"><text class="label data-v-6464a680">预订数量</text><view class="qty-control data-v-6464a680"><view data-event-opts="{{[['tap',[['decQty',['$event']]]]]}}" class="qty-btn data-v-6464a680" bindtap="__e">−</view><text class="qty-value data-v-6464a680">{{quantity}}</text><view data-event-opts="{{[['tap',[['incQty',['$event']]]]]}}" class="qty-btn data-v-6464a680" bindtap="__e">+</view></view></view><view class="form-row total data-v-6464a680"><text class="label data-v-6464a680">合计</text><text class="total-price data-v-6464a680">{{"¥"+goods.price*quantity}}</text></view></view><view class="card data-v-6464a680"><view class="tip data-v-6464a680">📌 预订提交后，批发商会收到通知并确认。请保持电话畅通。</view></view><button data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" class="btn-primary submit-btn data-v-6464a680" bindtap="__e">提交预订</button></view></block>