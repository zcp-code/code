<block wx:if="{{detail}}"><view class="container data-v-3dcca906"><view class="{{['hero','data-v-3dcca906','hero-'+detail.status]}}"><view class="hero-icon data-v-3dcca906">{{heroIcon}}</view><view class="hero-title data-v-3dcca906">{{$root.m0}}</view><view class="hero-desc data-v-3dcca906">{{heroDesc}}</view></view><view data-event-opts="{{[['tap',[['onGoodsTap',['$event']]]]]}}" class="card goods-card data-v-3dcca906" bindtap="__e"><image class="goods-img data-v-3dcca906" src="{{detail.cover||'/static/placeholder.png'}}" mode="aspectFill"></image><view class="goods-body data-v-3dcca906"><view class="goods-name data-v-3dcca906">{{detail.goods_name||'-'}}</view><view class="price-row data-v-3dcca906"><text class="price-num data-v-3dcca906">{{"¥"+$root.m1}}</text><text class="price-unit data-v-3dcca906">{{"/"+(detail.unit||'件')}}</text></view><view class="qty-row data-v-3dcca906">{{"× "+$root.g0+" "+(detail.unit||'')}}</view></view></view><view class="card total-card data-v-3dcca906"><view class="total-line data-v-3dcca906"><text class="total-label data-v-3dcca906">订单总额</text><text class="total-value data-v-3dcca906">{{"¥"+$root.m2}}</text></view><view class="total-sub data-v-3dcca906">{{'含 '+$root.g1+" "+(detail.unit||'')+" × ¥"+$root.m3+"/"+(detail.unit||'件')+''}}</view></view><view class="card info-card data-v-3dcca906"><view class="card-title data-v-3dcca906"><text class="card-title-bar data-v-3dcca906"></text><text class="card-title-text data-v-3dcca906">订单信息</text></view><view class="info-list data-v-3dcca906"><view class="info-row data-v-3dcca906"><text class="info-label data-v-3dcca906">预订编号</text><view class="info-value-wrap data-v-3dcca906"><text class="info-value data-v-3dcca906" selectable="{{true}}">{{detail.reservation_no}}</text><text data-event-opts="{{[['tap',[['copy',['$0','已复制订单号'],['detail.reservation_no']]]]]}}" class="info-copy data-v-3dcca906" bindtap="__e">复制</text></view></view><view class="info-row data-v-3dcca906"><text class="info-label data-v-3dcca906">店铺</text><text class="info-value data-v-3dcca906">{{detail.shop_name||'-'}}</text></view><block wx:if="{{detail.wholesaler_name}}"><view class="info-row data-v-3dcca906"><text class="info-label data-v-3dcca906">批发商</text><text class="info-value data-v-3dcca906">{{detail.wholesaler_name}}</text></view></block></view></view><view class="card timeline-card data-v-3dcca906"><view class="card-title data-v-3dcca906"><text class="card-title-bar data-v-3dcca906"></text><text class="card-title-text data-v-3dcca906">订单进度</text></view><view class="timeline data-v-3dcca906"><view class="{{['tl-item','data-v-3dcca906',(true)?'active':'']}}"><view class="tl-dot data-v-3dcca906"></view><view class="tl-content data-v-3dcca906"><view class="tl-title data-v-3dcca906">提交预订</view><view class="tl-time data-v-3dcca906">{{$root.m4}}</view></view></view><block wx:if="{{detail.confirm_time}}"><view class="{{['tl-item','data-v-3dcca906',(true)?'active':'']}}"><view class="tl-dot data-v-3dcca906"></view><view class="tl-content data-v-3dcca906"><view class="tl-title data-v-3dcca906">批发商确认</view><view class="tl-time data-v-3dcca906">{{$root.m5}}</view></view></view></block><block wx:if="{{detail.cancel_time}}"><view class="tl-item cancel data-v-3dcca906"><view class="tl-dot data-v-3dcca906"></view><view class="tl-content data-v-3dcca906"><view class="tl-title data-v-3dcca906">订单已取消</view><view class="tl-time data-v-3dcca906">{{$root.m6}}</view><block wx:if="{{detail.cancel_reason}}"><view class="tl-reason data-v-3dcca906">{{"原因:"+detail.cancel_reason}}</view></block></view></view></block><block wx:if="{{!detail.confirm_time&&!detail.cancel_time&&detail.status==='pending'}}"><view class="tl-item pending data-v-3dcca906"><view class="tl-dot data-v-3dcca906"></view><view class="tl-content data-v-3dcca906"><view class="tl-title dim data-v-3dcca906">等待批发商确认</view><view class="tl-time data-v-3dcca906">预计 24 小时内回复</view></view></view></block></view></view><view class="bottom-pad data-v-3dcca906"></view><block wx:if="{{detail.status==='pending'}}"><view class="action-bar data-v-3dcca906"><view class="action-inner data-v-3dcca906"><view data-event-opts="{{[['tap',[['cancel',['$event']]]]]}}" class="btn-ghost data-v-3dcca906" bindtap="__e">取消预订</view><view data-event-opts="{{[['tap',[['contactShop',['$event']]]]]}}" class="btn-solid data-v-3dcca906" bindtap="__e">联系商家</view></view></view></block></view></block><block wx:else><view class="loading-state data-v-3dcca906"><view class="loading-emoji data-v-3dcca906">⏳</view><view class="loading-text data-v-3dcca906">加载中...</view></view></block>