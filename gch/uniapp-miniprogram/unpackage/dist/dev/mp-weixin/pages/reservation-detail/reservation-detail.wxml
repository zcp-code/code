<block wx:if="{{detail}}"><view class="container data-v-3dcca906"><view class="{{['status-bar','data-v-3dcca906','status-'+detail.status]}}">{{''+$root.m0+''}}</view><view class="card data-v-3dcca906"><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">预订编号</text><text class="value data-v-3dcca906">{{detail.reservation_no}}</text></view><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">货品</text><text class="value data-v-3dcca906">{{detail.goods_name}}</text></view><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">单价</text><text class="value data-v-3dcca906">{{"¥"+detail.price+"/"+detail.unit}}</text></view><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">数量</text><text class="value data-v-3dcca906">{{detail.quantity+" "+detail.unit}}</text></view><view class="row total data-v-3dcca906"><text class="label data-v-3dcca906">合计</text><text class="value data-v-3dcca906">{{"¥"+detail.price*detail.quantity}}</text></view></view><view class="card data-v-3dcca906"><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">店铺</text><text class="value data-v-3dcca906">{{detail.shop_name||'-'}}</text></view><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">批发商</text><text class="value data-v-3dcca906">{{detail.wholesaler_name||'-'}}</text></view><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">预订时间</text><text class="value data-v-3dcca906">{{$root.m1}}</text></view><block wx:if="{{detail.confirm_time}}"><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">确认时间</text><text class="value data-v-3dcca906">{{$root.m2}}</text></view></block><block wx:if="{{detail.cancel_time}}"><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">取消时间</text><text class="value data-v-3dcca906">{{$root.m3}}</text></view></block><block wx:if="{{detail.cancel_reason}}"><view class="row data-v-3dcca906"><text class="label data-v-3dcca906">取消原因</text><text class="value data-v-3dcca906">{{detail.cancel_reason}}</text></view></block></view><block wx:if="{{detail.status==='pending'}}"><view class="action-bar data-v-3dcca906"><button data-event-opts="{{[['tap',[['cancel',['$event']]]]]}}" class="btn warn data-v-3dcca906" bindtap="__e">取消预订</button></view></block></view></block>