
.container.data-v-3dcca906 { min-height: 100vh; background: #f5f7fa; padding-bottom: 200rpx;
}

/* ===== Hero 顶部状态区 ===== */
.hero.data-v-3dcca906 {
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
  position: relative;
}
.hero-icon.data-v-3dcca906 { font-size: 96rpx; display: block; line-height: 1; margin-bottom: 20rpx;
}
.hero-title.data-v-3dcca906 { font-size: 38rpx; font-weight: 700; color: #fff; margin-bottom: 12rpx;
}
.hero-desc.data-v-3dcca906 { font-size: 26rpx; color: rgba(255, 255, 255, 0.85);
}
.hero-pending.data-v-3dcca906 {
  background: linear-gradient(135deg, #f59e0b 0%, #fb923c 100%);
}
.hero-confirmed.data-v-3dcca906 {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
}
.hero-cancelled.data-v-3dcca906 {
  background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%);
}

/* ===== Cards ===== */
.card.data-v-3dcca906 {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}
.card-title.data-v-3dcca906 {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.card-title-bar.data-v-3dcca906 {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #ff6600, #ff8c42);
  border-radius: 3rpx;
  margin-right: 12rpx;
}
.card-title-text.data-v-3dcca906 { font-size: 30rpx; font-weight: 700; color: #1f2937;
}

/* ===== Goods Card ===== */
.goods-card.data-v-3dcca906 { display: flex; gap: 24rpx; padding: 28rpx;
}
.goods-img.data-v-3dcca906 {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}
.goods-body.data-v-3dcca906 { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between;
}
.goods-name.data-v-3dcca906 { font-size: 30rpx; color: #1f2937; font-weight: 600; line-height: 1.4;
}
.price-row.data-v-3dcca906 { margin-top: 16rpx; display: flex; align-items: baseline;
}
.price-num.data-v-3dcca906 { font-size: 40rpx; color: #ff6600; font-weight: 700;
}
.price-unit.data-v-3dcca906 { font-size: 24rpx; color: #9ca3af; margin-left: 4rpx;
}
.qty-row.data-v-3dcca906 { font-size: 26rpx; color: #6b7280; margin-top: 6rpx;
}

/* ===== Total Card ===== */
.total-card.data-v-3dcca906 { padding: 28rpx;
}
.total-line.data-v-3dcca906 { display: flex; justify-content: space-between; align-items: baseline;
}
.total-label.data-v-3dcca906 { font-size: 28rpx; color: #6b7280;
}
.total-value.data-v-3dcca906 { font-size: 44rpx; color: #ff6600; font-weight: 700;
}
.total-sub.data-v-3dcca906 { font-size: 24rpx; color: #9ca3af; margin-top: 8rpx; text-align: right;
}

/* ===== Info Card ===== */
.info-list.data-v-3dcca906 { padding: 8rpx 28rpx 28rpx;
}
.info-row.data-v-3dcca906 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.info-row.data-v-3dcca906:last-child { border-bottom: none;
}
.info-label.data-v-3dcca906 { font-size: 26rpx; color: #9ca3af; flex-shrink: 0;
}
.info-value-wrap.data-v-3dcca906 { display: flex; align-items: center; gap: 16rpx; min-width: 0; flex: 1; justify-content: flex-end;
}
.info-value.data-v-3dcca906 {
  font-size: 28rpx;
  color: #1f2937;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}
.info-copy.data-v-3dcca906 {
  font-size: 22rpx;
  color: #ff6600;
  background: #fff1e6;
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

/* ===== Timeline ===== */
.timeline.data-v-3dcca906 { padding: 24rpx 28rpx 28rpx;
}
.tl-item.data-v-3dcca906 {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}
.tl-item.data-v-3dcca906:last-child { padding-bottom: 0;
}
.tl-item.data-v-3dcca906:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #e5e7eb;
}
.tl-item.active.data-v-3dcca906:not(:last-child)::before,
.tl-item.data-v-3dcca906:last-child::before { background: transparent;
}
.tl-dot.data-v-3dcca906 {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #cbd5e1;
  margin-right: 24rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.tl-item.active .tl-dot.data-v-3dcca906 {
  background: #ff6600;
  box-shadow: 0 0 0 6rpx #fff1e6;
}
.tl-item.cancel .tl-dot.data-v-3dcca906 { background: #9ca3af; box-shadow: 0 0 0 6rpx #f3f4f6;
}
.tl-item.pending .tl-dot.data-v-3dcca906 { background: #cbd5e1;
}
.tl-content.data-v-3dcca906 { flex: 1; min-width: 0;
}
.tl-title.data-v-3dcca906 { font-size: 28rpx; color: #1f2937; font-weight: 600;
}
.tl-title.dim.data-v-3dcca906 { color: #9ca3af; font-weight: 400;
}
.tl-time.data-v-3dcca906 { font-size: 24rpx; color: #9ca3af; margin-top: 6rpx;
}
.tl-reason.data-v-3dcca906 { font-size: 24rpx; color: #ef4444; margin-top: 8rpx;
}

/* ===== Bottom padding ===== */
.bottom-pad.data-v-3dcca906 { height: 40rpx;
}

/* ===== Action Bar ===== */
.action-bar.data-v-3dcca906 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  -webkit-backdrop-filter: blur(20rpx);
          backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
.action-inner.data-v-3dcca906 { display: flex; gap: 20rpx;
}
.btn-ghost.data-v-3dcca906 {
  flex: 1;
  text-align: center;
  border: 2rpx solid #e5e7eb;
  color: #6b7280;
  border-radius: 48rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-solid.data-v-3dcca906 {
  flex: 1;
  text-align: center;
  background: linear-gradient(135deg, #ff6600, #ff8c42);
  color: #fff;
  border-radius: 48rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255, 102, 0, 0.3);
}

/* ===== Loading State ===== */
.loading-state.data-v-3dcca906 {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-emoji.data-v-3dcca906 { font-size: 120rpx;
}
.loading-text.data-v-3dcca906 { font-size: 28rpx; color: #9ca3af; margin-top: 20rpx;
}

