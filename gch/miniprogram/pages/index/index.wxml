<view class="container">
  <!-- 顶部搜索 -->
  <view class="search-bar">
    <input class="search-input"
           placeholder="搜索货品名"
           value="{{keyword}}"
           bindinput="onSearchInput"
           bindconfirm="onSearchConfirm" />
    <view class="search-btn" bindtap="onSearchConfirm">搜索</view>
  </view>

  <!-- 商品列表 -->
  <view class="goods-list">
    <view class="goods-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="goods-cover" src="{{item.cover || '/images/placeholder.png'}}" mode="aspectFill"></image>
      <view class="goods-info">
        <view class="goods-name ellipsis-2">{{item.name}}</view>
        <view class="goods-shop">{{item.shop_name || ''}}</view>
        <view class="goods-bottom">
          <view class="goods-price">¥{{item.price}}/{{item.unit}}</view>
          <view class="goods-stock">可订 {{item.available || 0}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中...</view>
    <view wx:elif="{{finished && list.length > 0}}" class="loading">— 没有更多了 —</view>
    <view wx:elif="{{list.length === 0}}" class="empty">
      <text>暂无货盘</text>
      <view class="empty-tip">可点击下方"分类"切换，或联系批发商发布</view>
    </view>
  </view>
</view>
