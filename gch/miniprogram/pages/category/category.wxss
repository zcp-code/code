.grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 20rpx; padding: 10rpx 0;
}
.cat-card {
  background: #fff; border-radius: 12rpx;
  padding: 30rpx 0; text-align: center;
}
.cat-icon { font-size: 60rpx; }
.cat-name { font-size: 28rpx; margin-top: 10rpx; font-weight: 500; }
.cat-count { color: #999; font-size: 22rpx; margin-top: 6rpx; }
