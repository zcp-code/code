.user-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 12rpx; padding: 30rpx; margin-bottom: 20rpx;
}
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #f5f5f5; }
.user-info { flex: 1; margin-left: 20rpx; }
.nick { font-size: 32rpx; font-weight: 500; }
.role { color: #999; font-size: 24rpx; margin-top: 6rpx; }
.logout-btn { color: #ff6b35; font-size: 26rpx; padding: 10rpx 20rpx; }
.login-tip {
  flex: 1; text-align: center; color: #ff6b35; font-size: 30rpx; padding: 20rpx 0;
}

.section-title {
  font-size: 28rpx; font-weight: 500; padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee; margin-bottom: 16rpx;
}
.empty-tip { color: #999; font-size: 26rpx; padding: 20rpx 0; text-align: center; }
.quick-btn {
  background: #fff5f0; color: #ff6b35;
  text-align: center; padding: 20rpx 0; border-radius: 8rpx; margin-top: 16rpx;
}

.reservation {
  padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5;
}
.reservation:last-child { border-bottom: none; }
.res-row { display: flex; justify-content: space-between; }
.res-no { color: #999; font-size: 24rpx; }
.res-status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-pending { color: #ff9800; background: #fff3e0; }
.status-confirmed { color: #4caf50; background: #e8f5e9; }
.status-cancelled { color: #999; background: #f5f5f5; }
.res-name { font-size: 28rpx; margin-top: 8rpx; }
.res-amount { color: #ff6b35; font-size: 30rpx; font-weight: 500; margin-top: 8rpx; }
.res-actions { margin-top: 12rpx; text-align: right; }
.cancel-btn {
  display: inline-block; padding: 10rpx 24rpx; color: #f44336;
  border: 1rpx solid #f44336; border-radius: 6rpx; font-size: 24rpx;
}
