<view class="container">
  <view class="tabs">
    <view class="tab {{type === 'goods' ? 'active' : ''}}" data-type="goods" bindtap="switchType">收藏货品</view>
    <view class="tab {{type === 'shop' ? 'active' : ''}}" data-type="shop" bindtap="switchType">收藏店铺</view>
  </view>

  <!-- 货品卡片 -->
  <block wx:if="{{type === 'goods'}}">
    <view class="goods-card" wx:for="{{list}}" wx:key="id" bindtap="goGoods" data-id="{{item.goods_id || item.id}}">
      <image class="cover" src="{{item.cover || '/images/placeholder.png'}}" mode="aspectFill"></image>
      <view class="info">
        <view class="name ellipsis-2">{{item.name}}</view>
        <view class="shop">{{item.shop_name || ''}}</view>
        <view class="price">¥{{item.price}}/{{item.unit}}</view>
      </view>
    </view>
  </block>

  <!-- 店铺卡片 -->
  <block wx:elif="{{type === 'shop'}}">
    <view class="shop-card" wx:for="{{list}}" wx:key="id" bindtap="goShop" data-id="{{item.shop_id || item.id}}">
      <view class="shop-name">{{item.name}}</view>
      <view class="shop-meta">{{item.position || ''}}</view>
    </view>
  </block>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无收藏</view>
</view>
