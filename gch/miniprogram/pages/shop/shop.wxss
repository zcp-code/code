.logo {
  width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f5f5f5;
  margin-bottom: 20rpx;
}
.name { font-size: 36rpx; font-weight: 600; }
.meta { color: #666; font-size: 26rpx; margin-top: 12rpx; }
.intro { color: #999; font-size: 26rpx; margin-top: 20rpx; line-height: 1.6; }

.action-bar {
  display: flex; margin-top: 40rpx; gap: 20rpx;
}
.btn {
  flex: 1; padding: 24rpx 0; border-radius: 8rpx; text-align: center;
  font-size: 28rpx;
}
.btn.call { background: #f5f5f5; color: #333; }
.btn.fav { background: #ff6b35; color: #fff; }
