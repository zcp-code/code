<view class="container" wx:if="{{shop}}">
  <view class="card">
    <image src="{{shop.logo || '/images/placeholder.png'}}" mode="aspectFill" class="logo"></image>
    <view class="name">{{shop.name}}</view>
    <view class="meta">📍 {{shop.position || '暂无地址'}}</view>
    <view class="meta">🕐 {{shop.business_hours || '营业时间待定'}}</view>
    <view class="meta">📞 {{shop.contact_phone || '暂无电话'}}</view>
    <view class="intro" wx:if="{{shop.intro}}">{{shop.intro}}</view>
  </view>

  <view class="action-bar">
    <view class="btn call" bindtap="callShop">📞 联系店铺</view>
    <view class="btn fav" bindtap="toggleFav">☆ 收藏店铺</view>
  </view>
</view>
