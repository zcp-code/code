.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.logo-icon { font-size: 100rpx; }
.logo-text { font-size: 40rpx; font-weight: 600; color: #ff6b35; margin-top: 10rpx; }

.role-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}
.role-tab {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}
.role-tab.active {
  color: #ff6b35;
  border-bottom: 4rpx solid #ff6b35;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}
.form-row .label {
  width: 140rpx;
  color: #666;
}
.form-row .input {
  flex: 1;
  font-size: 30rpx;
}
.form-tip {
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0 0;
  line-height: 1.5;
}
